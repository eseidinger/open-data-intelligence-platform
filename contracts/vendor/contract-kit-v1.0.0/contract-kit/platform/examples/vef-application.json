{
  "apiVersion": "platform.example/v1alpha2",
  "kind": "Application",
  "metadata": {
    "name": "vef",
    "project": "vef",
    "environment": "default"
  },
  "spec": {
    "components": [
      {
        "name": "api",
        "type": "service",
        "runtime": {
          "type": "container",
          "image": "ghcr.io/eseidinger/vef-api:contract-kit-0.4.0"
        },
        "resources": {
          "requests": {
            "cpu": "250m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "outbound": [
          {
            "dns": "api-odip.apps.example.invalid",
            "port": 443
          },
          {
            "dns": "identity.example.invalid",
            "port": 443
          }
        ],
        "ports": [
          {
            "name": "http",
            "protocol": "http",
            "port": 8080
          }
        ],
        "replicas": 1,
        "exposure": "public",
        "health": {
          "readiness": {
            "path": "/health/ready",
            "port": 8080
          }
        }
      }
    ],
    "configuration": {
      "values": {
        "ODIP_ORIGIN": "https://api-odip.apps.example.invalid",
        "ODIP_DATASET_ID": "energy-reference-wasserburg-am-inn-2024",
        "ODIP_DATASET_VERSION": "1.0.0"
      }
    },
    "resources": [
      {
        "name": "database",
        "type": "postgres",
        "profile": "shared-dev",
        "deletionPolicy": "retain"
      }
    ]
  }
}
