{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio:energy:ai-explanation:v1",
  "title": "Energy AI explanation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "claims",
    "missingEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "energy-ai-explanation/v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{7,127}$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "category",
          "citations"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "category": {
            "enum": [
              "MEASURED_SOURCE_DATA",
              "DERIVED_REFERENCE_PROFILE",
              "CUSTOMER_INPUT",
              "MODEL_ASSUMPTION",
              "CALCULATED_OUTPUT"
            ]
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "pointer",
                "value"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                },
                "pointer": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                },
                "value": {}
              }
            }
          }
        }
      }
    },
    "missingEvidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
