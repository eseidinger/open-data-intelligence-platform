{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio:dataset-publication:v1",
  "title": "Immutable dataset publication manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "version",
    "status",
    "schemaRef",
    "metadata",
    "publishedAt",
    "artifacts",
    "quality",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "dataset-publication/v1" },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,99}$"
    },
    "version": { "$ref": "urn:portfolio:common:v1#/$defs/semanticVersion" },
    "status": { "const": "PUBLISHED" },
    "schemaRef": { "type": "string", "format": "uri" },
    "metadata": { "type": "object" },
    "publishedAt": { "$ref": "urn:portfolio:common:v1#/$defs/utcInstant" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "role",
          "mediaType",
          "sha256",
          "path"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,99}$"
          },
          "role": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,99}$"
          },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 100 },
          "unit": { "type": "string", "minLength": 1, "maxLength": 50 },
          "sha256": { "$ref": "urn:portfolio:common:v1#/$defs/sha256" },
          "path": {
            "type": "string",
            "pattern": "^artifacts/[a-z][a-z0-9-]{1,99}$"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policyRef", "warnings"],
      "properties": {
        "status": { "const": "PASS" },
        "policyRef": { "type": "string", "format": "uri" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "urn:portfolio:common:v1#/$defs/warning" }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceOwner",
          "license",
          "retrievedAt",
          "transformationVersion"
        ],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "sourceOwner": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
          "license": { "type": "string", "minLength": 1, "maxLength": 200 },
          "retrievedAt": { "$ref": "urn:portfolio:common:v1#/$defs/utcInstant" },
          "rawArtifactId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "transformationVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    }
  }
}
