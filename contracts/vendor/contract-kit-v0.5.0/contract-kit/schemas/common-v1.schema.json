{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio:common:v1",
  "title": "Shared contract definitions v1",
  "$defs": {
    "utcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "endExclusive", "step"],
      "properties": {
        "start": { "$ref": "#/$defs/utcInstant" },
        "endExclusive": { "$ref": "#/$defs/utcInstant" },
        "step": { "const": "PT1H" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "reference", "license", "retrievedAt"],
      "properties": {
        "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reference": { "type": "string", "format": "uri" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "license": { "type": "string", "minLength": 1, "maxLength": 200 },
        "retrievedAt": { "$ref": "#/$defs/utcInstant" }
      }
    },
    "datasetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "version", "schemaRef"],
      "properties": {
        "datasetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,99}$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "schemaRef": { "type": "string", "format": "uri" }
      }
    }
  }
}
