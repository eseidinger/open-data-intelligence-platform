{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio:energy:reference-load-shape:v1",
  "title": "Hourly normalized reference load shape v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "unit", "period", "values"],
  "properties": {
    "schemaVersion": { "const": "energy-reference-load-shape/v1" },
    "unit": { "const": "fraction" },
    "period": { "$ref": "urn:portfolio:common:v1#/$defs/period" },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8784,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "value"],
        "properties": {
          "start": { "$ref": "urn:portfolio:common:v1#/$defs/utcInstant" },
          "value": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
