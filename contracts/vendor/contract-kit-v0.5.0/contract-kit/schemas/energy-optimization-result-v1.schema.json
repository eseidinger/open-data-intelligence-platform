{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio:energy:optimization-result:v1",
  "title": "Completed energy optimization result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "dataset",
    "modelVersion",
    "simulationVersion",
    "optimizerVersion",
    "optimalityStatus",
    "evaluatedCandidateCount",
    "feasibleCandidateCount",
    "recommendedConfigurationId",
    "warnings",
    "createdAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "energy-optimization-result/v1" },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{7,127}$"
    },
    "status": { "enum": ["SUCCEEDED", "INFEASIBLE"] },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "version", "schemaRef", "manifestSha256"],
      "properties": {
        "datasetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,99}$"
        },
        "version": { "$ref": "urn:portfolio:common:v1#/$defs/semanticVersion" },
        "schemaRef": {
          "const": "urn:portfolio:energy-configuration-input:v1"
        },
        "manifestSha256": { "$ref": "urn:portfolio:common:v1#/$defs/sha256" }
      }
    },
    "modelVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "simulationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "optimizerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "optimalityStatus": {
      "enum": ["PROVEN_OPTIMAL", "FEASIBLE_NOT_PROVEN", "NOT_APPLICABLE"]
    },
    "evaluatedCandidateCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "feasibleCandidateCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "recommendedConfigurationId": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "urn:portfolio:common:v1#/$defs/warning" }
    },
    "createdAt": { "$ref": "urn:portfolio:common:v1#/$defs/utcInstant" },
    "completedAt": { "$ref": "urn:portfolio:common:v1#/$defs/utcInstant" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUCCEEDED" } } },
      "then": {
        "properties": {
          "feasibleCandidateCount": { "minimum": 1 },
          "recommendedConfigurationId": { "type": "string" },
          "optimalityStatus": {
            "enum": ["PROVEN_OPTIMAL", "FEASIBLE_NOT_PROVEN"]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "INFEASIBLE" } } },
      "then": {
        "properties": {
          "feasibleCandidateCount": { "const": 0 },
          "recommendedConfigurationId": { "const": null },
          "optimalityStatus": { "const": "NOT_APPLICABLE" }
        }
      }
    }
  ]
}
