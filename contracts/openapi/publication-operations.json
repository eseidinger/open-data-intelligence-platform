{
  "openapi": "3.1.0",
  "info": {
    "title": "ODIP publication preparation and operator API",
    "version": "1.0.0",
    "description": "Extensions to the pinned consumer API. The platform owns route/group authorization: browser operator routes use its session and CSRF boundary, and worker routes use approved service bindings. ODIP validates trusted context and independently enforces dataset grants, job ownership, and claim tokens without local group checks or operator bypasses."
  },
  "components": {
    "securitySchemes": {
      "platformSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-platform-session"
      },
      "platformBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "DraftId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ArtifactId": {
        "name": "artifact",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,99}$"
        }
      },
      "DatasetId": {
        "name": "dataset",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uri"
        }
      },
      "Csrf": {
        "name": "X-Platform-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemas": {
      "DraftRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasetId",
          "manifest"
        ],
        "properties": {
          "datasetId": {
            "type": "string",
            "format": "uuid"
          },
          "manifest": {
            "$ref": "../vendor/contract-kit-v1.0.0/contract-kit/schemas/dataset-publication-v1.schema.json"
          },
          "rawArtifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ValidationReport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifestSha256",
          "policyRef",
          "checks",
          "artifactDigests",
          "claimToken"
        ],
        "properties": {
          "manifestSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "policyRef": {
            "type": "string",
            "format": "uri"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            }
          },
          "artifactDigests": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "claimToken": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Grant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principalId",
          "permission"
        ],
        "properties": {
          "principalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "permission": {
            "enum": [
              "READ",
              "WRITE",
              "INGEST",
              "VALIDATE"
            ]
          }
        }
      },
      "Draft": {
        "type": "object",
        "required": [
          "id",
          "datasetId",
          "status",
          "manifestSha256",
          "manifest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "datasetId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "DRAFT",
              "VALIDATING",
              "FAILED",
              "PUBLISHED"
            ]
          },
          "manifestSha256": {
            "type": "string"
          },
          "manifest": {
            "$ref": "../vendor/contract-kit-v1.0.0/contract-kit/schemas/dataset-publication-v1.schema.json"
          },
          "report": {
            "type": [
              "object",
              "null"
            ]
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "claimToken": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "RawInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payload",
          "contentLength",
          "checksumSha256"
        ],
        "properties": {
          "payload": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "contentType": {
            "type": [
              "string",
              "null"
            ]
          },
          "contentLength": {
            "type": "integer",
            "minimum": 0
          },
          "checksumSha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sourceVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "validation": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "status": {
                "enum": [
                  "VALID",
                  "INVALID",
                  "UNSUPPORTED"
                ]
              },
              "detectedFormat": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recordCount": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "schemaFingerprint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failureReason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "transformation": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "data": {
                "type": "object"
              }
            }
          },
          "claimToken": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "StorageMigrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apply": {
            "type": "boolean",
            "default": false
          }
        },
        "description": "Preview by default. Apply only after reviewing the artifact identity and checksum."
      },
      "StorageMigrationResult": {
        "type": "object",
        "required": [
          "status",
          "sha256",
          "contentLength",
          "postgresCopyRetained"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "migrated",
              "already_migrated"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contentLength": {
            "type": "integer",
            "minimum": 0
          },
          "postgresCopyRetained": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Error400": {
        "description": "Invalid request, fields, or idempotency header"
      },
      "Error401": {
        "description": "Missing or invalid trusted context or service credential"
      },
      "Error403": {
        "description": "Platform route or local dataset permission denied"
      },
      "Error409": {
        "description": "Conflicting idempotency key, immutable version, or stale claim"
      },
      "Error413": {
        "description": "Decoded body, manifest, or artifact exceeds its bound"
      },
      "Error422": {
        "description": "Schema, checksum, profile, or aggregate publication limit failure"
      },
      "Error503": {
        "description": "Platform access material unavailable"
      },
      "Error404": {
        "description": "Dataset, draft, version, or artifact not found"
      }
    }
  },
