{
  "apiVersion": "platform.example/v1alpha2",
  "kind": "Application",
  "metadata": {
    "name": "odip",
    "project": "odip",
    "environment": "default"
  },
  "spec": {
    "configuration": {
      "values": {
        "ODIP_API_URL": "http://web:8080",
        "ODIP_AUTHORIZATION_USER_GROUP_IDS": "grp_e2987e192a0a41b4a0273c71c14fef47",
        "ODIP_AUTHORIZATION_GUEST_GROUP_IDS": "grp_8461fd4adec843d9be0d466a38fd564e",
        "ODIP_API_PRINCIPAL_ID": "odip-ingestion-worker",
        "ODIP_API_PRINCIPAL_KIND": "service",
        "ODIP_API_PRINCIPAL_ISSUER": "https://odip.internal",
        "ODIP_API_PRINCIPAL_SUBJECT": "odip-ingestion-worker",
        "ODIP_API_PRINCIPAL_GROUP_IDS": "grp_e2987e192a0a41b4a0273c71c14fef47"
      }
    },
    "components": [
      {
        "name": "web",
        "type": "service",
        "runtime": {
          "type": "container",
          "image": "docker.io/eseidinger/odip-platform:latest"
        },
        "ports": [
          {
            "name": "http",
            "protocol": "http",
            "port": 8080
          }
        ],
        "resources": {
          "requests": {
            "cpu": "250m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "exposure": "public",
        "health": {
          "readiness": {
            "path": "/actuator/health/readiness"
          }
        }
      },
      {
        "name": "ingestion-worker",
        "type": "scheduled",
        "runtime": {
          "type": "container",
          "image": "docker.io/eseidinger/odip-data-worker:latest",
          "args": ["--claim-next"]
        },
        "schedule": "* * * * *",
        "concurrencyPolicy": "Forbid",
        "retryLimit": 0,
        "maxRunSeconds": 300,
        "outbound": [
          {
            "dns": "jsonplaceholder.typicode.com",
            "port": 443
          }
        ]
      }
    ]
  }
}
