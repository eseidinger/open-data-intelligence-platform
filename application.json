{
  "apiVersion": "platform.example/v1alpha2",
  "kind": "Application",
  "metadata": {
    "name": "odip",
    "project": "odip",
    "environment": "default"
  },
  "spec": {
    "configuration": {
      "values": {
        "ODIP_API_URL": "http://web:8080"
      }
    },
    "components": [
      {
        "name": "web",
        "type": "service",
        "runtime": {
          "type": "container",
          "image": "docker.io/eseidinger/odip-platform:latest"
        },
        "ports": [
          {
            "name": "http",
            "protocol": "http",
            "port": 8080
          }
        ],
        "resources": {
          "requests": {
            "cpu": "250m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "exposure": "public",
        "health": {
          "readiness": {
            "path": "/actuator/health/readiness"
          }
        }
      },
      {
        "name": "ingestion-worker",
        "type": "scheduled",
        "runtime": {
          "type": "container",
          "image": "docker.io/eseidinger/odip-data-worker:latest",
          "args": ["--claim-next"]
        },
        "schedule": "* * * * *",
        "concurrencyPolicy": "Forbid",
        "retryLimit": 0,
        "maxRunSeconds": 300
      }
    ]
  }
}
