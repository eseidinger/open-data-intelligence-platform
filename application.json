{
  "apiVersion": "platform.example/v1alpha2",
  "kind": "Application",
  "metadata": {
    "name": "odip",
    "project": "odip",
    "environment": "default"
  },
  "spec": {
    "configuration": {
      "values": {
        "ODIP_API_URL": "https://web-odip.apps.eseidinger.de",
        "ODIP_IDENTITY_MODE": "platform",
        "ODIP_SOURCE_HOSTS": "jsonplaceholder.typicode.com,ec.europa.eu,re.jrc.ec.europa.eu,github.com",
        "ODIP_WORKER_BINDING_PREFIX": "ACCESS_BCC37E90DE10"
      }
    },
    "components": [
      {
        "name": "web",
        "type": "service",
        "runtime": {
          "type": "container",
          "image": "docker.io/eseidinger/odip-platform:integration-0.4.0"
        },
        "ports": [
          {
            "name": "http",
            "protocol": "http",
            "port": 8080
          }
        ],
        "resources": {
          "requests": {
            "cpu": "250m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "exposure": "public",
        "health": {
          "readiness": {
            "path": "/actuator/health/readiness"
          }
        }
      },
      {
        "name": "ingestion-worker",
        "type": "scheduled",
        "runtime": {
          "type": "container",
          "image": "docker.io/eseidinger/odip-data-worker:integration-0.4.0",
          "args": [
            "--claim-next"
          ]
        },
        "schedule": "* * * * *",
        "concurrencyPolicy": "Forbid",
        "retryLimit": 0,
        "maxRunSeconds": 300,
        "outbound": [
          {
            "dns": "web-odip.apps.eseidinger.de",
            "port": 443
          },
          {
            "dns": "identity.eseidinger.de",
            "port": 443
          },
          {
            "dns": "re.jrc.ec.europa.eu",
            "port": 443
          },
          {
            "dns": "ec.europa.eu",
            "port": 443
          },
          {
            "dns": "jsonplaceholder.typicode.com",
            "port": 443
          }
        ],
        "resources": {
          "requests": {
            "cpu": "250m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        }
      }
    ],
    "resources": [
      {
        "name": "database",
        "type": "postgres",
        "profile": "shared-dev",
        "deletionPolicy": "retain"
      }
    ]
  }
}
